[Unit]
Description=ZZZ IM Fairy bot service
Wants=network-online.target
After=network-online.target zzz-im.service

[Service]
Type=simple
User=zzz-fairy
Group=zzz-fairy
WorkingDirectory=/var/lib/zzz-fairy
EnvironmentFile=/etc/zzz-im/fairy.env
ExecStart=/usr/local/bin/zzz-im-fairy
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zzz-fairy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
